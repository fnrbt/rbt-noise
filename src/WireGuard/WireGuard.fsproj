<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>The WireGuard handshake and transport protocol built on the Noise library.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="WireGuard.fs" />
    <Compile Include="Adapters.fs" />
    <Compile Include="Device.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Noise\Noise.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
  </ItemGroup>

</Project>
